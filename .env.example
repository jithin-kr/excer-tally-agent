# ─── Tally (on this machine) ──────────────────────────────────────────────
TALLY_HOST=localhost
TALLY_PORT=9000
# Company name EXACTLY as it appears in Tally. Blank = whichever company is open.
TALLY_COMPANY=
TALLY_TIMEOUT_MS=60000

# ─── This agent ───────────────────────────────────────────────────────────
AGENT_PORT=7010
# Shared secret the Excer app sends as x-api-key. Generate a long random string.
AGENT_API_KEY=change-me
AGENT_ID=excer-tally-agent-1
POLL_INTERVAL_MS=15000
HEARTBEAT_INTERVAL_MS=30000
# When a voucher is entered in Tally, every item's closing stock is re-read. On a busy day this
# caps how often that heavier query runs. Changes are never lost, only batched.
STOCK_REFRESH_MIN_INTERVAL_MS=60000
# How long a call back into the Excer app may take (ms). Raise it for the first sync of a large company.
APP_TIMEOUT_MS=15000
# Where the sync watermarks are saved, so a restart does not re-export everything.
AGENT_STATE_FILE=state/poll-state.json
# Posts every voucher as Optional in Tally (not into the regular books) until an accountant
# converts it — the review step now that pushes are automatic, not button-triggered (CLAUDE.md
# §21/§22). Only set to false once proven reliable against a real Tally test company (§22.6).
TALLY_POST_VOUCHERS_AS_OPTIONAL=true
# Except Delivery Notes: Tally owns stock, and a website sale lowers Tally's stock only through its
# Delivery Note. An Optional one moves no stock until converted, so these post Regular by default.
TALLY_POST_DELIVERY_NOTES_AS_OPTIONAL=false

# ─── Calling back into the Excer app ──────────────────────────────────────
EXCER_APP_URL=https://excer.example.com
EXCER_APP_TOKEN=change-me

# ─── Installation-specific Tally naming (CLAUDE.md 20.6 Q9/Q15/Q16) ───────
# ALL of these must be confirmed with the client's Tally person before go-live.
# The defaults are Tally's out-of-the-box names and are very likely wrong here.
TALLY_VT_SALES_ORDER=Sales Order
TALLY_VT_DELIVERY_NOTE=Delivery Note
TALLY_VT_CREDIT_NOTE=Credit Note
TALLY_VT_STOCK_JOURNAL=Stock Journal
TALLY_LEDGER_SALES=Sales Accounts
TALLY_LEDGER_CGST=CGST
TALLY_LEDGER_SGST=SGST
TALLY_LEDGER_IGST=IGST
TALLY_LEDGER_DISCOUNT=Discount Allowed
# Books with one sales ledger and one set of tax ledgers PER GST RATE (common; the client's are
# "Sales@18%", "CGST@9%", ...): rate=sales|cgst|sgst|igst, one rate per ";". A line whose rate is
# listed posts there; any other rate uses the single TALLY_LEDGER_* names above. Names are used
# exactly as written, spaces inside included. `npm run doctor` checks every one exists.
# TALLY_LEDGERS_BY_RATE=18=Sales@18%|CGST@9%|SGST@9%|IGST @18%; 12=Sales@12%|CGST @6%|SGST @6%|IGST 12%; 5=Sales@5%|CGST 2.5%|SGST 2.5%|IGST @ 5%
TALLY_LEDGERS_BY_RATE=
TALLY_GROUP_CUSTOMERS=Sundry Debtors
# Blank if godowns are not in use.
TALLY_GODOWN=
TALLY_HOME_STATE=Kerala
